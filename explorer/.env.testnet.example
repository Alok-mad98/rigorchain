# Development / testnet only. Production deploy must not load this file.
# Separate database from mainnet and from any local regtest explorer.
PG_URL=postgres://postgres@127.0.0.1:5432/rigor_explorer_testnet
RIGOR_CLI_BIN=./core/src/rigor-cli
RIGOR_DATADIR=/var/lib/rigor/testnet
RIGOR_NETWORK=testnet
RIGOR_RPC_PORT=18761
API_PORT=8081
API_HOST=127.0.0.1
POLL_INTERVAL_MS=2000
IMPORT_BATCH_MAX_HEIGHT=100
STOP_ON_ROOT_MISMATCH=true
RATE_LIMIT_ENABLED=true
INDEXER_NAME=rigor-explorer-testnet
EXPLORER_BUILD_TIMESTAMP=testnet-import
