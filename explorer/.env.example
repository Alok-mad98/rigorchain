# Copy to .env.local and adjust paths, then:
#   set -a && source .env.local && set +a && npm run dev
#
# PostgreSQL (required)
PG_URL=postgres://postgres:postgres@127.0.0.1:5432/rigor_explorer

# rigor-cli / rigord (required for indexer import; UI still serves if RPC is down)
RIGOR_CLI_BIN=./core/src/rigor-cli
RIGOR_DATADIR=/var/lib/rigor/mainnet
# mainnet | testnet | regtest | devtest — required; explorer refuses to start if unset
RIGOR_NETWORK=mainnet
# v0.1.3 JSON-RPC (chainparamsbase). Never assume Bitcoin 8332.
RIGOR_RPC_PORT=8761
# Required when the node was started with -rpcuser (cookie auth disabled)
# RIGOR_RPC_USER=rigor
# RIGOR_RPC_PASSWORD=change-me
# Address HRP is locked to chainparams (mainnet=rg, testnet=trg, regtest=rgrt, devtest=dvt).
# Setting BECH32_HRP to any other value is a startup error.
# BECH32_HRP=rg

# Explorer display
EXPLORER_BUILD_TIMESTAMP=development
API_PORT=8080
POLL_INTERVAL_MS=30000

# Indexer mismatch recovery
# true (default) = stall import on root mismatch; false = import with mismatch flags (lab only)
STOP_ON_ROOT_MISMATCH=true
MISMATCH_RETRY_INTERVAL_MS=60000

# API rate limiting (per-IP sliding window)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_TX_MAX=60
RATE_LIMIT_BLOCK_MAX=60
RATE_LIMIT_ADDRESS_MAX=60
RATE_LIMIT_LINEAGE_MAX=40
RATE_LIMIT_STATUS_MAX=30
RATE_LIMIT_HEALTH_MAX=60
RATE_LIMIT_COMPLIANCE_MAX=30

# Set true when behind nginx / reverse proxy
TRUST_PROXY=false
