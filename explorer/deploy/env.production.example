# Copy to /etc/rigor/explorer.env (mode 0640). Canonical production Explorer.
# Public host: http://explorer.rigorchain.com (HTTPS later, after TLS is issued)
# This file is mainnet-only. Do not source .env.testnet.example from the
# production unit. Use a database that has never indexed another chain.

PG_URL=postgres://postgres:postgres@127.0.0.1:5432/rigor_explorer_mainnet

RIGOR_CLI_BIN=/opt/rigor/bin/rigor-cli
RIGOR_DATADIR=/var/lib/rigor/mainnet
RIGOR_NETWORK=mainnet
RIGOR_RPC_PORT=8761
# RIGOR_RPC_USER=
# RIGOR_RPC_PASSWORD=

API_PORT=8080
API_HOST=127.0.0.1
POLL_INTERVAL_MS=30000
IMPORT_BATCH_MAX_HEIGHT=50

STOP_ON_ROOT_MISMATCH=true
RATE_LIMIT_ENABLED=true
TRUST_PROXY=true

EXPLORER_BUILD_TIMESTAMP=production
INDEXER_NAME=rigor-explorer

# Qt wallet keeps RigorExplorer/ApiBaseUrl configurable.
# Production example value (not a compiled default):
# http://explorer.rigorchain.com
