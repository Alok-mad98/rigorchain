# Copy to /etc/rigor/explorer.env (mode 0640). Fail-closed production shape.
# Public hostname reserved: explorer.rigorchain.com — do not point DNS until
# testnet full import (G6) is checked. Until then run testnet on this file.

PG_URL=postgres://postgres:postgres@127.0.0.1:5432/rigor_explorer_testnet

RIGOR_CLI_BIN=/opt/rigor/bin/rigor-cli
RIGOR_DATADIR=/var/lib/rigor/testnet
RIGOR_NETWORK=testnet
RIGOR_RPC_PORT=18761
# RIGOR_RPC_USER=
# RIGOR_RPC_PASSWORD=

API_PORT=8080
API_HOST=127.0.0.1
POLL_INTERVAL_MS=30000
IMPORT_BATCH_MAX_HEIGHT=50

STOP_ON_ROOT_MISMATCH=true
RATE_LIMIT_ENABLED=true
TRUST_PROXY=true

EXPLORER_BUILD_TIMESTAMP=production
INDEXER_NAME=rigor-explorer
