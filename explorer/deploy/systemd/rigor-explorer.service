[Unit]
Description=RIGOR Explorer indexer (read-only mainnet observer)
# Canonical production unit name: rigor-explorer.service
# EnvironmentFile must set RIGOR_NETWORK=mainnet and a mainnet-only database.
# explorer-indexer-mvp.service is not this unit and is not installed in production.
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=rigor
Group=rigor
WorkingDirectory=/opt/rigor/explorer
EnvironmentFile=/etc/rigor/explorer.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rigor-explorer

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
