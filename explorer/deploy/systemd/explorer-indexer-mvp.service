[Unit]
Description=RIGOR Explorer Indexer MVP (read-only, not the production unit)
# Not canonical. The public explorer host does not install this unit.
# Production unit name: rigor-explorer.service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=rigor
Group=rigor
WorkingDirectory=/opt/ring/explorer-indexer-mvp
EnvironmentFile=/etc/rigor/explorer-indexer.env
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=explorer-indexer-mvp

# Hardening (adjust if your Node install path differs)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
