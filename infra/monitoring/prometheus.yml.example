# EXAMPLE — copy to prometheus.yml; do not commit secrets.
global:
  scrape_interval: 30s
  evaluation_interval: 30s

rule_files:
  - rigord-alerts.yml

scrape_configs:
  - job_name: node
    static_configs:
      - targets:
          - seed01-mgmt:9100
          - seed02-mgmt:9100
        labels:
          role: seed

  - job_name: blackbox_p2p
    metrics_path: /probe
    params:
      module: [tcp_connect]
    static_configs:
      - targets:
          - seed01.example.org:8760
          - seed02.example.org:8760
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
