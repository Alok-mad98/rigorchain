# RIGOR Miner Dashboard — example environment (no secrets required)

# Bind (localhost only; non-loopback is refused)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=18083

# Read-only upstreams (public display surfaces)
EXPLORER_URL=http://127.0.0.1:18081
OBS_URL=http://127.0.0.1:18082
NODE_RPC_HOST=127.0.0.1
NODE_RPC_PORT=8761

# Quarantined pool observer (not the SOLO path)
POOL_STRATUM_HOST=127.0.0.1
POOL_STRATUM_PORT=13333

# Optional pool / miner files (never commit live status.json)
# POOL_STATUS_FILE=
# MINER_LOG=

# Optional wallet RPC via rigor-cli + cookie/datadir.
# Do not put rpcpassword in the dashboard UI, git, or screenshots.
# WALLET_CLI=rigor-cli
# WALLET_DATADIR=
# WALLET_RPC_PORT=8761
# WALLET_NAME=
# MINING_ADDRESS=rg1q...

MINER_PLATFORM=Windows
